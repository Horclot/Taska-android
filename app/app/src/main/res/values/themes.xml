<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовые темы -->
    <style name="Base.Theme.Taska" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основные цвета -->
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryVariant">@color/light_purple</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_blue</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Скругленные углы (стандартные для Material Components) -->
        <item name="cornerRadius">28dp</item>

        <!-- Убираем темную тему для стартового экрана -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="ThemeOverlay.Taska.TimePicker"
        parent="ThemeOverlay.MaterialComponents.TimePicker">

        <item name="colorPrimary">#FF6B6B</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <item name="colorSurface">#1C1F26</item>
        <item name="colorOnSurface">@android:color/white</item>

        <item name="colorSecondary">#FF6B6B</item>
    </style>


    <!-- Основная тема приложения -->
    <style name="Theme.Taska" parent="Base.Theme.Taska">
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="QuickActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- Тема для стартового экрана -->
    <style name="Theme.Taska.Splash" parent="Theme.Taska">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowBackground">@drawable/background_gradient</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Taska.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="Theme.Taska.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <!-- Стиль для табов -->

    <!-- Стиль для Snackbar -->
</resources>