<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Анимация появления -->
    <item name="slide_up" type="anim">
        <set>
            <translate
                android:fromYDelta="50"
                android:toYDelta="0"
                android:duration="400"/>
            <alpha
                android:fromAlpha="0"
                android:toAlpha="1"
                android:duration="400"/>
        </set>
    </item>

    <item name="scale_out" type="anim">
        <set>
            <scale
                android:fromXScale="1"
                android:toXScale="0"
                android:fromYScale="1"
                android:toYScale="0"
                android:pivotX="50%"
                android:pivotY="50%"
                android:duration="300"/>
            <alpha
                android:fromAlpha="1"
                android:toAlpha="0"
                android:duration="300"/>
        </set>
    </item>

    <!-- Шейк анимация -->
    <item name="shake" type="anim">
        <translate
            android:fromXDelta="0"
            android:toXDelta="10"
            android:duration="50"
            android:repeatCount="5"
            android:repeatMode="reverse"/>
    </item>
</resources>