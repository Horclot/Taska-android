<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="16dp"
    android:layout_marginVertical="8dp"
    android:background="@android:color/transparent">

    <!-- Вертикальная линия для пустого слота с градиентом -->
    <View
        android:id="@+id/emptySlotLine"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_line_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/emptySlotIcon"
        app:layout_constraintStart_toStartOf="@id/emptySlotIcon"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Время для пустого слота -->
    <TextView
        android:id="@+id/emptySlotTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14:00"
        android:textColor="#9AA0A6"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/emptySlotIcon"
        app:layout_constraintEnd_toStartOf="@+id/emptySlotIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/emptySlotIcon" />

    <!-- Иконка пустого слота -->
    <ImageView
        android:id="@+id/emptySlotIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="48dp"
        android:background="@drawable/bg_circle_blue"
        android:backgroundTint="#FF2A2E38"
        android:padding="8dp"
        android:src="@drawable/ic_add_neon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/emptySlotLine"
        app:tint="#FFFFFF" />

    <!-- Карточка пустого слота -->
    <androidx.cardview.widget.CardView
        android:id="@+id/emptySlotCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@color/divider"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/emptySlotIcon"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/emptySlotTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Добавить занятие"
                android:textColor="#9AA0A6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/emptySlotHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Свободное окно · Запланировать?"
                android:textColor="#676E7E"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>