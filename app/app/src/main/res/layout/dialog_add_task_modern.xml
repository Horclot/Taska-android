<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#1C1F26"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Новое занятие"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"/>

        <!-- Название -->
        <EditText
            android:id="@+id/titleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название"
            android:textColor="@android:color/white"
            android:textColorHint="#7F8A9C"
            android:background="@drawable/bg_input_dark"
            android:padding="12dp"
            android:layout_marginBottom="10dp"/>

        <!-- Описание -->
        <EditText
            android:id="@+id/descriptionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Описание (необязательно)"
            android:textColor="@android:color/white"
            android:textColorHint="#7F8A9C"
            android:background="@drawable/bg_input_dark"
            android:padding="12dp"
            android:layout_marginBottom="14dp"/>

        <!-- Приоритет -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Приоритет"
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <RadioGroup
            android:id="@+id/priorityRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/priorityLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Низкий"
                android:buttonTint="#4CAF50"
                android:textColor="@android:color/white"/>

            <RadioButton
                android:id="@+id/priorityMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Средний"
                android:checked="true"
                android:buttonTint="#FF9800"
                android:textColor="@android:color/white"/>

            <RadioButton
                android:id="@+id/priorityHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Высокий"
                android:buttonTint="#F44336"
                android:textColor="@android:color/white"/>
        </RadioGroup>

        <!-- Время -->
        <EditText
            android:id="@+id/timeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Время"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:textColor="@android:color/white"
            android:textColorHint="#7F8A9C"
            android:background="@drawable/bg_input_dark"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>


        <!-- День -->
        <Spinner
            android:id="@+id/daySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_dark"
            android:layout_marginBottom="14dp"/>

        <!-- Повтор -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ежедневно"
                android:textColor="@android:color/white"/>

            <Switch
                android:id="@+id/isRecurringSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Кнопки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancelBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Отмена"
                android:textColor="@android:color/white"
                android:backgroundTint="#2A2E38"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Сохранить"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF6B6B"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
