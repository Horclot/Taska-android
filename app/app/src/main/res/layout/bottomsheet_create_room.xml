<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F1115"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Создание пространства"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/roomTitleInput"
        android:hint="Название"
        android:textColor="#FFFFFF"
        android:textColorHint="#8A8F98"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/roomDescInput"
        android:hint="Цель пространства"
        android:textColor="#FFFFFF"
        android:textColorHint="#8A8F98"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/inviteCodeText"
        android:layout_marginTop="20dp"
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/copyInviteBtn"
        android:text="Скопировать код"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/showQrBtn"
        android:text="Показать QR"
        android:textColor="#4CAF50"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/membersContainer"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/createRoomBtn"
        android:text="Создать пространство"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
